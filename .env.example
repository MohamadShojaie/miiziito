# PostgreSQL — used by PHP API and local Python dev API
# Copy to .env and adjust for production
MIIZIITO_DATABASE_URL=postgresql://lumiere:lumiere@127.0.0.1:5432/lumiere

# Legacy alias (still supported)
# LUMIERE_DATABASE_URL=postgresql://lumiere:lumiere@127.0.0.1:5432/lumiere

# Optional alias (also read by storage layer)
# DATABASE_URL=postgresql://lumiere:lumiere@127.0.0.1:5432/lumiere

# Local dev API port (Next.js proxies /api here in development)
MIIZIITO_API_PORT=8787

# Host port for Docker Postgres
MIIZIITO_PG_PORT=5432
